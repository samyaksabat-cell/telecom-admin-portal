# Optional local demo configuration. No credentials or external services required.
# Copy to .env.local at the repository root. See README.md for loading instructions.
# Never put real customer data or secrets in this committed template.

# Next.js server-side /api proxy target, also used by Playwright.
# Use an origin without /api or a trailing slash.
BACKEND_URL=http://localhost:8080

# Playwright browser target (does not configure the Next.js listening port).
FRONTEND_URL=http://localhost:3000

# Next.js listening port. Must match FRONTEND_URL for local browser tests.
PORT=3000

# Spring Boot listening port. Must match BACKEND_URL for the local backend.
# Spring Boot does not read .env.local; export it as described in README.md.
SERVER_PORT=8080

# Optional Spring Boot datasource override. Normally leave unset.
# Relative SQLite paths resolve from backend/ when using the pnpm scripts.
# The Python seeder always writes backend/app.db, regardless of this override.
# SPRING_DATASOURCE_URL=jdbc:sqlite:app.db
